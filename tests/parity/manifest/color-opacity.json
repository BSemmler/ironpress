  {
    "id": "opacity-text-glyph-group",
    "category": "color-opacity",
    "feature": "opacity",
    "subfeature": "text-group",
    "description": "Overlapping glyphs in one opacity:.5 element flatten before compositing; catches per-glyph alpha drawing where overlaps become too bright.",
    "file": "cases/color-opacity/opacity-text-glyph-group.html",
    "kind": "interaction",
    "interaction_of": [
      "opacity",
      "text"
    ],
    "expected_support": "implemented",
    "reference": {
      "status": "disputed",
      "note": "Both PDFs are rasterized by the same pinned pdftoppm command. Ironpress composites the overlapping glyphs as one opacity group: its fully painted glyph colour is the same #808080 as Chrome's (52,577 versus 52,595 pixels), so the overlap is not brightened by per-glyph alpha. The remaining raw diff is a one-device-pixel contour residue. The Ironpress PDF embeds ParitySans as CID TrueType while Chrome's PDF uses Type 3, so their PDF glyph programs produce slightly different edge coverage in that shared rasterization. This does not indicate missing opacity-group support; raw evidence remains reported."
    },
    "depends_on": [
      "probe-color-swatch",
      "probe-text-baseline"
    ]
  },
